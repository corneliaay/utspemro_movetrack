<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F6FB"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Riwayat Aktivitas"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#183B56"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftar aktivitas fisik yang telah kamu tambahkan."
        android:textSize="14sp"
        android:textColor="#66788A"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvEmptyList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada aktivitas tersimpan."
        android:textSize="16sp"
        android:textColor="#66788A"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone"/>

    <!-- DAFTAR AKTIVITAS TERSIMPAN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutHistoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kembali ke Beranda"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#183B56"
        android:textColor="#FFFFFF"/>

</LinearLayout>
